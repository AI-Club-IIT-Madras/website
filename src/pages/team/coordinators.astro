---
import Arrow from "../../components/Arrow.astro";
import PageHeading from "../../components/PageHeading.astro";
import TeamGrid from "../../components/TeamGrid.astro";
import team from "../../data/team.json";
import Layout from "../../layouts/Layout.astro";
import { localUrl } from "../../lib/urls";

const sections = [
  {
    id: "club-coordinators",
    label: "Club Coordinators",
    members: [
      ...team.members.filter((member) => member.group === "club-coordinators"),
      ...team.members.filter(
        (member) => member.role === "Project Member & Coordinator",
      ),
    ],
  },
  {
    id: "hackathon-coordinators",
    label: "Hackathon Coordinators",
    members: team.members.filter(
      (member) => member.group === "hackathon-coordinators",
    ),
  },
];
---

<Layout title="Coordinators">
  <PageHeading title="Meet Our Coordinators">
    <div class="year-nav">
      <a class="text-link" href={localUrl("/team/")}>
        Core team <Arrow />
      </a>
    </div>
  </PageHeading>
  <div class="shell team-directory">
    {sections.map((section) => (
      <section class="team-section" id={section.id}>
        <div class="team-section-heading" data-reveal="pop">
          <h2>{section.label}</h2>
        </div>
        <TeamGrid members={section.members} reveal />
      </section>
    ))}
  </div>
</Layout>
