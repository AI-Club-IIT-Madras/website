---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import YearNav from "../components/YearNav.astro";
import Partners from "../components/Partners.astro";
import projects from "../data/projects.json";
import site from "../data/site.json";
import { academicYear } from "../lib/urls";
export function getStaticPaths() {
  return ["22-25", "25-26", "26-27"].map((year) => ({ params: { year } }));
}
const year = Astro.params.year!;
const yearProjects = projects.filter(
  (project) => project.academicYear === year,
);
const archiveTenures = ["24-25", "23-24"];
---

<Layout title={`${site.labels.projects} ${academicYear(year)}`}>
  <PageHeading title={site.labels.projects}>
    <YearNav kind="projects" current={year} />
  </PageHeading>
  <div class="shell archive-content">
    {year === "22-25" ? (
      <div class="archive-project-groups">
        {archiveTenures.map((tenure) => (
          <section
            class="archive-project-group"
            aria-labelledby={`projects-${tenure}`}
          >
            <h2 id={`projects-${tenure}`}>{academicYear(tenure)}</h2>
            <div class="project-grid">
              {yearProjects
                .filter((project) => project.tenure === tenure)
                .map((project) => (
                  <ProjectCard project={project} />
                ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="project-grid">
        {yearProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    )}
  </div>
  {year === "25-26" && <Partners variant="projects2526" />}
  {year === "26-27" && <Partners variant="projects" />}
</Layout>
