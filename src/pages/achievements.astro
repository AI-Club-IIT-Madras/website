---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading.astro";
import Arrow from "../components/Arrow.astro";
import achievements from "../data/achievements.json";
import site from "../data/site.json";
import { localUrl } from "../lib/urls";
---

<Layout title={site.labels.achievements}>
  <PageHeading title={site.labels.achievements} />
  {["Research", "Patents"].map((category, index) => (
    <section class="section shell">
      <h2 class="section-title" data-reveal={index % 2 ? "right" : "left"}>
        {category}
      </h2>
      <div class="research-list">
        {achievements.publications
          .filter((item) => item.category === category)
          .map((item) => (
            <article class="research-card card" data-reveal="row">
              <h3>
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  {item.title}
                </a>
              </h3>
              <p>{item.description}</p>
              <a
                class="text-link"
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${site.labels.readArticle}: ${item.title}`}
              >
                {site.labels.readArticle}
                <Arrow diagonal />
              </a>
            </article>
          ))}
      </div>
    </section>
  ))}
  <section class="section shell">
    <h2 class="section-title" data-reveal="left">
      {site.labels.hackathons}
    </h2>
    <div class="hackathon-grid">
      {achievements.hackathons.map((item) => (
        <article class="hackathon-card" data-reveal="row">
          <div class="hackathon-image">
            <img
              src={localUrl(item.image)}
              alt=""
              loading="lazy"
              width="600"
              height="300"
            />
          </div>
          <div class="hackathon-card-body">
            <h3>{item.title}</h3>
            <p class:list={["hackathon-result", item.result.toLowerCase()]}>
              {item.result}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
