---
import Layout from "../../layouts/Layout.astro";
import PageHeading from "../../components/PageHeading.astro";
import Arrow from "../../components/Arrow.astro";
import TeamGrid from "../../components/TeamGrid.astro";
import details from "../../data/project-details.json";
import projects from "../../data/projects.json";
import site from "../../data/site.json";
import team from "../../data/team.json";
import { localUrl } from "../../lib/urls";
export function getStaticPaths() {
  return details.map((detail) => ({
    params: { id: detail.id },
    props: { detail },
  }));
}
const { detail } = Astro.props;
const project = projects.find((project) => project.id === detail.id)!;
const projectTeam = team.members.filter((member) => member.group === detail.id);
---

<Layout title={detail.title} description={detail.description}>
  <PageHeading
    title={detail.title}
    subtitle={detail.description}
    eyebrow={detail.tagline || undefined}
  >
    <div class="year-nav">
      <a href={localUrl("/projects-26-27/")}>{site.labels.backProjects}</a>
      <a href="#team">{site.labels.meetTeam} →</a>
    </div>
  </PageHeading>
  <div class="shell detail-hero archive-content">
    <img
      class="detail-visual"
      src={localUrl(project.image!)}
      width="1100"
      height="470"
      alt={`${project.title} — project illustration`}
    />
    <section class="detail-section project-team-section" id="team">
      <h2>{detail.teamHeading}</h2>
      <TeamGrid members={projectTeam} />
    </section>
    {detail.applicationHeading && (
      <section class="detail-section">
        <h2>{detail.applicationHeading}</h2>
        <p>{detail.applicationNote}</p>
        {detail.embed && (
          <>
            <a
              class="button button-secondary"
              href={detail.embed.replace("/preview", "/view")}
              target="_blank"
              rel="noopener noreferrer"
            >
              {site.labels.application}
              <Arrow diagonal />
            </a>
            <details class="document-preview">
              <summary>{site.labels.showApplication}</summary>
              <iframe
                src={detail.embed}
                title={`${detail.title} application document`}
                loading="lazy"
                referrerpolicy="no-referrer"
              />
            </details>
          </>
        )}
      </section>
    )}
    <section class="detail-section">
      <h2>{site.labels.publications}</h2>
      <p>{site.labels.comingSoon}</p>
      <p class="todo-copy">{site.labels.missingPublications}</p>
    </section>
  </div>
</Layout>
