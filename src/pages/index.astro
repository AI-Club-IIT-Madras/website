---
import Layout from "../layouts/Layout.astro";
import EventCard from "../components/EventCard.astro";
import BlogCard from "../components/BlogCard.astro";
import Partners from "../components/Partners.astro";
import Contact from "../components/Contact.astro";
import Arrow from "../components/Arrow.astro";
import site from "../data/site.json";
import events from "../data/events.json";
import blogs from "../data/blogs.json";
import achievements from "../data/achievements.json";
import announcements from "../data/announcements.json";
import { newestPublished } from "../lib/content.mjs";
import { localUrl } from "../lib/urls";
const recentEvents = newestPublished(events).slice(0, 3);
const recentBlogs = newestPublished(blogs).slice(0, 3);
const featuredResearch = achievements.publications
  .filter((item) => item.category === "Research")
  .slice(0, 3);
const featuredHackathons = achievements.hackathons.slice(0, 3);
---

<Layout>
  <section class="hero shell">
    <h1 data-reveal="left">{site.name}</h1>
    <p class="hero-copy" data-reveal="right">
      {site.introduction}
    </p>
    <a
      class="scroll-cue"
      href="#events"
      aria-label={site.labels.scrollToEvents}
    >
      <svg viewBox="0 0 20 32" fill="none" aria-hidden="true">
        <path d="m3 3 7 6 7-6M3 12l7 6 7-6M3 21l7 6 7-6" />
      </svg>
    </a>
  </section>
  <section class="section shell" id="events" data-reveal="right">
    <div class="section-head">
      <h2 class="section-title">{site.labels.events}</h2>
      <a
        class="text-link"
        href={localUrl(`/events/${recentEvents[0]?.academicYear || "26-27"}/`)}
      >
        {site.labels.allEvents}
        <Arrow />
      </a>
    </div>
    {announcements.upcomingEvent.status === "placeholder" && (
      <p class="upcoming-status">
        <span>{site.labels.upcomingEvents}</span>
        <strong>{site.labels.noUpcomingEvents}</strong>
      </p>
    )}
    <div class="event-grid">
      {recentEvents.map((event) => (
        <EventCard event={event} compact />
      ))}
    </div>
  </section>
  <section class="section shell" data-reveal="left">
    <div class="section-head">
      <h2 class="section-title">{site.labels.blogs}</h2>
      <a class="text-link" href={localUrl("/blog/")}>
        {site.labels.allBlogs}
        <Arrow />
      </a>
    </div>
    <div class="blog-grid">
      {recentBlogs.map((blog) => (
        <BlogCard blog={blog} />
      ))}
    </div>
  </section>
  <section class="section shell home-achievements" id="achievements">
    <div class="section-head" data-reveal="right">
      <h2 class="section-title">{site.labels.achievements}</h2>
      <a class="text-link" href={localUrl("/achievements/")}>
        {site.labels.allAchievements}
        <Arrow />
      </a>
    </div>
    <div class="home-achievement-layout">
      <section class="home-achievement-panel card" data-reveal="left">
        <h3>{site.labels.research}</h3>
        <ul class="home-research-list">
          {featuredResearch.map((item) => (
            <li>
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                {item.title}
                <Arrow diagonal />
              </a>
              <p>{item.description}</p>
            </li>
          ))}
        </ul>
      </section>
      <section class="home-achievement-panel card" data-reveal="right">
        <h3>{site.labels.hackathons}</h3>
        <ul class="home-award-list">
          {featuredHackathons.map((item) => (
            <li>
              <img
                src={localUrl(item.image)}
                alt=""
                width="112"
                height="84"
                loading="lazy"
                decoding="async"
              />
              <div>
                <h4>{item.title}</h4>
                <p class:list={["hackathon-result", item.result.toLowerCase()]}>
                  {item.result}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>
  <Partners reveal="left" />
  <Contact reveal="right" />
</Layout>
