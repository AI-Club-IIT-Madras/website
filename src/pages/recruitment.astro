---
import Layout from "../layouts/Layout.astro";
import { localUrl } from "../lib/urls";
import recruitment from "../data/recruitment.json";

const linkIsReady = (url: string | null): url is string =>
  typeof url === "string" && /^(https?:\/\/|mailto:)/.test(url);
---

<Layout title="DC Recruitment" description="Join AI Club IIT Madras as a Deputy Coordinator. Explore the experience, application information and stories from previous DCs.">
  <div class="recruitment-page">
    <section class="recruitment-hero" aria-labelledby="recruitment-heading">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-inner">
        <p class="eyebrow">AI CLUB · IIT MADRAS</p>
        <h1 id="recruitment-heading">{recruitment.headline}</h1>
        <p class="hero-subtitle">{recruitment.subheading}</p>
        <a class="hero-scroll" href="#benefits">Explore the opportunity <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section id="benefits" class="recruitment-section benefits-section" aria-labelledby="benefits-heading">
      <div class="benefits-copy">
        <p class="eyebrow">WHY JOIN US</p>
        <h2 id="benefits-heading">What's in it for you?</h2>
        <div class="benefits-list">
          {recruitment.benefits.map((benefit, index) => (
            <div class="benefit">
              <span class="benefit-index" aria-hidden="true">0{index + 1}</span>
              <p><strong>{benefit.heading}:</strong> {benefit.description}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="quick-links" aria-label="Recruitment links">
        {recruitment.links.map((link) => (
          <div class="link-item">
            {linkIsReady(link.url) ? (
              <a class="link-tile" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
                <span class="icon-circle">
                  {link.icon === "file" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8"/></svg>}
                  {link.icon === "chat" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8A8.5 8.5 0 0 1 12.5 20a8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8A8.5 8.5 0 0 1 12.5 3 8.5 8.5 0 0 1 21 11.5Z"/><path d="M9 10c.6 2 2 3.4 4 4"/></svg>}
                  {link.icon === "play" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m10 8 6 4-6 4z"/></svg>}
                  {link.icon === "upload" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 16v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4"/></svg>}
                </span>
                <span class="link-label">{link.label} <span aria-hidden="true">↗</span></span>
              </a>
            ) : (
              <div class="link-tile link-pending" aria-label={`${link.label}: link coming soon`}>
                <span class="icon-circle">
                  {link.icon === "file" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8"/></svg>}
                  {link.icon === "chat" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8A8.5 8.5 0 0 1 12.5 20a8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8A8.5 8.5 0 0 1 12.5 3 8.5 8.5 0 0 1 21 11.5Z"/><path d="M9 10c.6 2 2 3.4 4 4"/></svg>}
                  {link.icon === "play" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m10 8 6 4-6 4z"/></svg>}
                  {link.icon === "upload" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 16v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4"/></svg>}
                </span>
                <span class="link-label">{link.label}</span>
                <span class="pending-note">Link coming soon</span>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="recruitment-section testimonials-section" aria-labelledby="testimonials-heading">
      <div class="testimonials-heading">
        <p class="eyebrow">THE DC EXPERIENCE</p>
        <h2 id="testimonials-heading">Hear from our previous DCs</h2>
        <p>Real experiences, projects and lessons from members who have been part of the journey.</p>
      </div>
      <div class="testimonial-stack">
        {recruitment.testimonials.map((person, index) => (
          <article class:list={["testimonial-card", { "testimonial-reverse": index % 2 === 1 }]}>
            <div class="testimonial-photo">
              <img src={localUrl(person.image)} alt={`Portrait of ${person.name}`} loading="lazy" decoding="async" width="340" height="400" />
            </div>
            <div class="testimonial-content">
              <span class="quote-symbol" aria-hidden="true">“</span>
              <h3>{person.name}</h3>
              <p class="person-branch">{person.branch}</p>
              <blockquote>{person.quote}</blockquote>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .recruitment-page{position:relative;isolation:isolate;background:#050408;color:#fff;font-family:Inter,'Instrument Sans',sans-serif;overflow:hidden}
  .recruitment-hero{min-height:clamp(560px,80vh,760px);display:grid;place-items:center;position:relative;overflow:hidden;background:radial-gradient(ellipse at 10% 40%,#a77bfa 0%,#6b1bd1 25%,#2b0b70 48%,#080512 80%,#050408 100%)}
  .recruitment-hero::before{content:"";position:absolute;inset:0;opacity:.15;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");pointer-events:none}
  .hero-glow{position:absolute;width:550px;height:550px;border-radius:50%;left:-330px;top:10%;background:#e4c9ff;filter:blur(110px);opacity:.48;pointer-events:none}
  .hero-inner{position:relative;text-align:center;padding:110px 24px 90px;max-width:1250px;margin:auto}
  .eyebrow{font-size:.78rem;font-weight:700;letter-spacing:.24em;color:#d0a8ff;text-transform:uppercase}
  .hero-inner .eyebrow{margin-bottom:22px}
  .recruitment-hero h1{font-size:clamp(3.1rem,7vw,7rem);font-weight:750;letter-spacing:-.055em;line-height:1.06;text-wrap:balance;margin:0}
  .hero-subtitle{font-size:clamp(1.2rem,2.5vw,2.4rem);line-height:1.3;margin:28px 0 0;color:#fff}
  .hero-scroll{display:inline-flex;gap:12px;align-items:center;margin-top:55px;padding:12px 20px;border:1px solid #ffffff65;border-radius:30px;color:#fff;text-decoration:none;font-size:.93rem;transition:background .2s}
  .hero-scroll:hover{background:#ffffff23}
  .recruitment-section{width:min(1200px,calc(100% - 48px));margin:0 auto}
  .benefits-section{display:grid;grid-template-columns:minmax(0,1.16fr) minmax(0,.84fr);gap:clamp(30px,6vw,100px);padding-top:110px;padding-bottom:120px;align-items:center}
  .benefits-copy h2,.testimonials-heading h2{font-size:clamp(2.5rem,4.3vw,4.4rem);line-height:1.12;letter-spacing:-.045em;margin:14px 0 35px;color:white;font-weight:730}
  .benefits-list{display:grid;gap:26px}
  .benefit{display:flex;align-items:start;gap:18px}
  .benefit-index{font-size:.8rem;color:#ad79ff;letter-spacing:.04em;font-weight:700;flex:none;padding-top:6px}
  .benefit p{font-size:clamp(1rem,1.35vw,1.16rem);line-height:1.7;color:#d8d2e4;margin:0}
  .benefit strong{color:#fff;font-weight:700}
  .quick-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 22px}
  .link-tile{min-height:175px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;border:1px solid #39234f;background:linear-gradient(145deg,#1b1127,#0d0a12);border-radius:24px;padding:22px 10px;text-decoration:none;color:white;text-align:center;transition:transform .2s,border-color .2s,background .2s}
  a.link-tile:hover{transform:translateY(-5px);border-color:#a453ff;background:#261238}
  a.link-tile:focus-visible,.hero-scroll:focus-visible{outline:3px solid #d9b1ff;outline-offset:4px}
  .icon-circle{width:77px;height:77px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,#a600ff,#6600f5);box-shadow:0 8px 30px #8c00ff38;color:white}
  .icon-circle svg{width:37px;height:37px}
  .link-label{font-weight:650;font-size:1.04rem}
  .pending-note{font-size:.75rem;color:#baaac9}
  .link-pending{cursor:default}
  .testimonials-section{padding:0 0 125px}
  .testimonials-heading{text-align:center;max-width:850px;margin:0 auto 60px}
  .testimonials-heading h2{margin-bottom:15px}
  .testimonials-heading>p:last-child{color:#aca3b7;font-size:1.08rem;line-height:1.6}
  .testimonial-stack{display:grid;gap:27px;max-width:1050px;margin:auto}
  .testimonial-card{display:grid;grid-template-columns:270px minmax(0,1fr);gap:36px;align-items:center;padding:27px;background:linear-gradient(125deg,rgba(48,29,69,.72),rgba(17,12,25,.95));border:1px solid #52306d;border-radius:25px;box-shadow:0 13px 35px #0005}
  .testimonial-reverse{grid-template-columns:minmax(0,1fr) 270px}
  .testimonial-reverse .testimonial-photo{order:2}
  .testimonial-photo{width:100%;height:295px;border-radius:17px;overflow:hidden;background:#261632}
  .testimonial-photo img{width:100%;height:100%;object-fit:cover;display:block}
  .testimonial-content{min-width:0}
  .quote-symbol{font-family:Georgia,serif;color:#a965ff;font-size:5rem;line-height:.65;display:block;margin:0 0 19px}
  .testimonial-content h3{color:#fff;font-size:clamp(1.6rem,2.6vw,2.2rem);line-height:1.1;letter-spacing:-.02em;margin:0 0 9px}
  .person-branch{color:#c39aff;font-weight:650;font-size:1.04rem;margin:0 0 20px}
  .testimonial-content blockquote{border:0;padding:0;margin:0;color:#e0dbe8;font-size:1.04rem;line-height:1.75;white-space:pre-line}
  @media(max-width:850px){.benefits-section{grid-template-columns:1fr;padding-top:75px;padding-bottom:85px}.quick-links{max-width:650px;width:100%;margin:auto}.testimonial-card,.testimonial-reverse{grid-template-columns:220px 1fr;gap:22px;padding:20px}.testimonial-reverse{grid-template-columns:1fr 220px}.testimonial-photo{height:255px}}
  @media(max-width:600px){.recruitment-section{width:min(100% - 32px,1200px)}.recruitment-hero{min-height:570px}.hero-inner{padding:100px 17px}.hero-scroll{margin-top:42px}.benefits-section{padding-top:65px;padding-bottom:85px}.benefits-copy h2,.testimonials-heading h2{margin-bottom:30px}.quick-links{gap:14px}.link-tile{min-height:148px;border-radius:19px;padding:16px 8px}.icon-circle{width:62px;height:62px}.icon-circle svg{width:30px;height:30px}.link-label{font-size:.91rem}.pending-note{font-size:.69rem}.testimonial-stack{gap:22px}.testimonial-card,.testimonial-reverse{grid-template-columns:1fr;gap:20px;padding:19px}.testimonial-reverse .testimonial-photo{order:0}.testimonial-photo{height:290px;max-width:100%}.testimonial-content{padding:4px 3px 9px}.testimonials-heading{margin-bottom:35px}.testimonials-section{padding-bottom:85px}}
  @media(prefers-reduced-motion:reduce){.link-tile,.hero-scroll{transition:none}}
</style>
