---
import Arrow from "../components/Arrow.astro";
import PageHeading from "../components/PageHeading.astro";
import TeamGrid from "../components/TeamGrid.astro";
import team from "../data/team.json";
import Layout from "../layouts/Layout.astro";
import { localUrl } from "../lib/urls";

const projectNames = {
  "viveka-2": "Viveka 2.0",
  "triton-cu": "triton::cu",
  kathai: "KathAI",
};

const projectLeads = team.members.filter(
  (member) => member.role === "Project Lead",
);
const clubLeads = team.members
  .filter((member) => member.group === "club")
  .map((member) => {
    const projectLead = projectLeads.find(
      (candidate) => candidate.name === member.name,
    );
    return {
      ...member,
      role: projectLead
        ? [
            member.role,
            `Project Lead · ${projectNames[projectLead.group as keyof typeof projectNames]}`,
          ]
        : member.role,
    };
  });
const hackathonLeads = team.members.filter(
  (member) =>
    member.group === "hackathon-core" && member.role === "Hackathon Lead",
);
const listedLeadNames = new Set(
  [...clubLeads, ...hackathonLeads].map((member) => member.name),
);
const remainingProjectLeads = projectLeads
  .filter((member) => !listedLeadNames.has(member.name))
  .map((member) => ({
    ...member,
    role: `Project Lead · ${projectNames[member.group as keyof typeof projectNames]}`,
  }));
const leads = [...clubLeads, ...hackathonLeads, ...remainingProjectLeads];
const cores = team.members.filter(
  (member) =>
    member.group === "hackathon-core" && member.role === "Hackathon Core",
);
const previousLeads = team.members.filter(
  (member) => member.group === "previous-leads",
);
const projectTeamLinks = [
  {
    label: "Viveka 2.0",
    href: "https://viveka.aiclubcfi.com/team.html#v2",
    external: true,
  },
  {
    label: "triton::cu",
    href: "/projects-26-27/triton-cu/#team",
    external: false,
  },
  {
    label: "KathAI",
    href: "/projects-26-27/kathai/#team",
    external: false,
  },
];

const sections = [
  {
    id: "leads",
    label: "Leads",
    members: leads,
    link: "/team/coordinators/#club-coordinators",
  },
  {
    id: "cores",
    label: "Cores",
    members: cores,
    link: "/team/coordinators/#hackathon-coordinators",
  },
  {
    id: "previous-leads",
    label: "Previous Team Leads",
    members: previousLeads,
  },
];
---

<Layout title="Meet the Team">
  <PageHeading title="Meet the Team!" eyebrow="Core team" />
  <div class="shell team-directory">
    {sections.map((section) => (
      <section class="team-section" id={`team-${section.id}`}>
        <div class="team-section-heading">
          <h2>{section.label}</h2>
          {section.link && (
            <a class="text-link" href={localUrl(section.link)}>
              Meet our coordinators
              <Arrow />
            </a>
          )}
        </div>
        <TeamGrid members={section.members} />
        {section.id === "leads" && (
          <nav class="project-team-links" aria-label="Project member pages">
            <span>Meet our project members</span>
            <div>
              {projectTeamLinks.map((project) => (
                <a
                  class="text-link"
                  href={localUrl(project.href)}
                  target={project.external ? "_blank" : undefined}
                  rel={project.external ? "noopener noreferrer" : undefined}
                >
                  {project.label}
                  <Arrow diagonal={project.external} />
                </a>
              ))}
            </div>
          </nav>
        )}
      </section>
    ))}
  </div>
</Layout>
