---
import Arrow from "../components/Arrow.astro";
import PageHeading from "../components/PageHeading.astro";
import TeamGrid from "../components/TeamGrid.astro";
import Layout from "../layouts/Layout.astro";
import team from "../data/team.json";
import { localUrl } from "../lib/urls";

const projectRoutes = {
  "viveka-2": "/projects-26-27/viveka-2/#team",
  "triton-cu": "/projects-26-27/triton-cu/#team",
  kathai: "/projects-26-27/kathai/#team",
};

const sections = [
  {
    id: "club",
    label: "Team Leads & Strategists",
    link: "/team/coordinators/#club-coordinators",
    linkLabel: "Meet our coordinators",
  },
  ...team.groups
    .filter((group) => group.page === "project")
    .map((group) => ({
      id: group.id,
      label: `${group.label} Leads`,
      link: projectRoutes[group.id as keyof typeof projectRoutes],
      linkLabel: "Meet the project team",
      role: "Project Lead",
    })),
  {
    id: "hackathon-core",
    label: "Hackathon Leads & Core",
    link: "/team/coordinators/#hackathon-coordinators",
    linkLabel: "Meet our coordinators",
  },
];
---

<Layout title="Meet the Team">
  <PageHeading title="Meet the Team!" eyebrow="Core team" />
  <div class="shell team-directory">
    {sections.map((section) => {
      const members = team.members.filter(
        (member) =>
          member.group === section.id &&
          (!("role" in section) || member.role === section.role),
      );

      return (
        <section class="team-section" id={`team-${section.id}`}>
          <div class="team-section-heading">
            <h2>{section.label}</h2>
            <a class="text-link" href={localUrl(section.link)}>
              {section.linkLabel}
              <Arrow />
            </a>
          </div>
          <TeamGrid members={members} />
        </section>
      );
    })}
  </div>
</Layout>
