---
import Layout from "../layouts/Layout.astro";
import PageHeading from "./PageHeading.astro";
import YearNav from "./YearNav.astro";
import EventCard from "./EventCard.astro";
import events from "../data/events.json";
import announcements from "../data/announcements.json";
import site from "../data/site.json";
import { academicYear } from "../lib/urls";
import { partitionEvents } from "../lib/content.mjs";
interface Props {
  year: string;
}
const { year } = Astro.props;
const records = events.filter(event => event.status === "published" && event.academicYear === year);
const { upcoming: upcomingRecords, past: pastRecords } = partitionEvents(records);
const upcoming = announcements.upcomingEvent;
const youtube = site.socials.find((social) => social.label === "YouTube");
---

<Layout title={`${site.labels.events} ${academicYear(year)}`}>
  <PageHeading title={site.labels.events}>
    <YearNav kind="events" current={year} />
  </PageHeading>
  <div class="shell archive-content">
    {year === "26-27" && !upcomingRecords.length && (
      <p class="upcoming-status">
        <span>{site.labels.upcomingEvents}</span>
        <strong>{site.labels.noUpcomingEvents}</strong>
      </p>
    )}
    {year === "26-27" &&
      !records.length &&
      upcoming.status !== "placeholder" && (
        <section class="upcoming-placeholder card">
          <div>
            <p class="eyebrow">{site.labels.upcoming}</p>
            <h2>{upcoming.title || site.labels.announcementPlaceholder}</h2>
            <p class="todo-copy">
              {upcoming.description || site.labels.upcomingNote}
            </p>
          </div>
          <span class="placeholder-symbol" aria-hidden="true">
            — —
          </span>
        </section>
      )}
    {youtube && (
      <p class="events-recording-note">
        {site.labels.eventRecordings}{" "}
        <a href={youtube.href} target="_blank" rel="noopener noreferrer">
          {site.labels.youtubePage}
        </a>
      </p>
    )}
    {upcomingRecords.length > 0 && (
      <section class="event-archive-section upcoming-events-section">
        <div class="year-heading">
          <h2>{site.labels.upcoming}</h2>
          <span>{upcomingRecords.length} {site.labels.eventCount}</span>
        </div>
        <div class="event-list upcoming-event-list">
          {upcomingRecords.map(event => <EventCard event={event} />)}
        </div>
      </section>
    )}
    {pastRecords.length > 0 && (
      <section class="event-archive-section past-events-section">
        <div class="year-heading">
          <h2>
            {upcomingRecords.length ? site.labels.pastEvents : academicYear(year)}
          </h2>
          <span>
            {pastRecords.length} {site.labels.eventCount}
          </span>
        </div>
        <div class="event-list">
          {pastRecords.map((event, index) => (
            <EventCard event={event} stackIndex={index} />
          ))}
        </div>
      </section>
    )}
    {!records.length && <p class="team-empty">{site.labels.emptyEvents}</p>}
  </div>
</Layout>
