---
import type events from "../data/events.json";
import { localUrl } from "../lib/urls";
import site from "../data/site.json";
import Arrow from "./Arrow.astro";
interface Props {
  event: (typeof events)[number];
  compact?: boolean;
  stackIndex?: number;
}
const { event, compact = false, stackIndex } = Astro.props;
const href = localUrl(`/events/${event.academicYear}/#${event.id}`);
const resourceLinks =
  "resourceLinks" in event && event.resourceLinks ? event.resourceLinks : [];
const descriptionParagraphs = event.description.split(/\n\s*\n/);
---

<article
  class:list={[
    "event-card card",
    { compact, stacked: stackIndex !== undefined },
  ]}
  id={compact ? undefined : event.id}
  style={
    stackIndex === undefined
      ? undefined
      : `--stack-top: ${112 + stackIndex * 14}px; --stack-depth: ${stackIndex + 1};`
  }
>
  {!compact && event.legacyAnchor && (
    <span id={event.legacyAnchor} class="legacy-anchor" aria-hidden="true" />
  )}
  {event.image ? (
    <img
      src={localUrl(event.image)}
      width="560"
      height="380"
      alt={`${event.title} — event artwork`}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class="image-placeholder">
      <span>{event.title}</span>
    </div>
  )}
  <div class="event-content">
    <h3>{compact ? <a href={href}>{event.title}</a> : event.title}</h3>
    <div class:list={["event-description", { "line-clamp-3": compact }]}>
      {compact
        ? descriptionParagraphs.join(" ")
        : descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {compact ? (
      <a class="text-link" href={href}>
        {site.labels.events}
        <Arrow />
      </a>
    ) : resourceLinks.length ? (
      <details class="event-resources">
        <summary class="button button-secondary">
          {site.labels.resources}
          <span class="resource-chevron" aria-hidden="true">
            ⌄
          </span>
        </summary>
        <div class="event-resource-menu">
          {resourceLinks.map((resource) => (
            <a href={resource.url} target="_blank" rel="noopener noreferrer">
              {resource.label}
              <Arrow diagonal />
            </a>
          ))}
        </div>
      </details>
    ) : (
      event.resourceUrl && (
        <a
          class="button button-secondary"
          href={event.resourceUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {site.labels.resources}
          <Arrow diagonal />
        </a>
      )
    )}
    <dl class="event-meta" aria-label="Event details">
      <div class="event-meta-item">
        <dt>{site.labels.date}</dt>
        <dd>
          {event.date ? (
            <time datetime={event.date}>{event.displayDate}</time>
          ) : (
            <span>{event.displayDate}</span>
          )}
        </dd>
      </div>
      {event.displayTime && (
        <div class="event-meta-item">
          <dt>{site.labels.time}</dt>
          <dd>{event.displayTime}</dd>
        </div>
      )}
      {event.location && (
        <div class="event-meta-item event-meta-venue">
          <dt>{site.labels.venue}</dt>
          <dd>{event.location}</dd>
        </div>
      )}
    </dl>
  </div>
</article>
