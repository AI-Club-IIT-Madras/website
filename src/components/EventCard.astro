---
import type events from "../data/events.json";
import { localUrl } from "../lib/urls";
import site from "../data/site.json";
import Arrow from "./Arrow.astro";
interface Props {
  event: (typeof events)[number];
  compact?: boolean;
  stackIndex?: number;
}
const { event, compact = false, stackIndex } = Astro.props;
const href = localUrl(`/events/${event.academicYear}/#${event.id}`);
const resourceLinks =
  "resourceLinks" in event && event.resourceLinks ? event.resourceLinks : [];
const descriptionParagraphs = event.description.split(/\n\s*\n/);
const eventQuestions =
  "questions" in event && event.questions ? event.questions : [];
const countdownTo =
  "countdownTo" in event && event.countdownTo ? event.countdownTo : null;
const registrationUrl =
  "registrationUrl" in event && event.registrationUrl
    ? event.registrationUrl
    : null;
---

<article
  class:list={[
    "event-card card",
    {
      compact,
      stacked: stackIndex !== undefined,
      "has-countdown": Boolean(countdownTo),
    },
  ]}
  id={compact ? undefined : event.id}
  style={
    stackIndex === undefined
      ? undefined
      : `--stack-top: ${112 + stackIndex * 14}px; --stack-depth: ${stackIndex + 1};`
  }
>
  {!compact && event.legacyAnchor && (
    <span id={event.legacyAnchor} class="legacy-anchor" aria-hidden="true" />
  )}
  {event.image ? (
    <img
      src={localUrl(event.image)}
      width="560"
      height="380"
      alt={`${event.title} — event artwork`}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class="image-placeholder">
      <span>{event.title}</span>
    </div>
  )}
  <div class="event-content">
    {!compact && countdownTo && (
      <p class="event-upcoming-badge">{site.labels.upcoming}</p>
    )}
    <h3>{compact ? <a href={href}>{event.title}</a> : event.title}</h3>
    <div class:list={["event-description", { "line-clamp-3": compact }]}>
      {compact ? (
        descriptionParagraphs.join(" ")
      ) : (
        <>
          {descriptionParagraphs
            .slice(0, eventQuestions.length ? 1 : undefined)
            .map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          {eventQuestions.length > 0 && (
            <ul class="event-questions">
              {eventQuestions.map((question) => (
                <li>{question}</li>
              ))}
            </ul>
          )}
          {eventQuestions.length > 0 &&
            descriptionParagraphs
              .slice(1)
              .map((paragraph) => <p>{paragraph}</p>)}
        </>
      )}
    </div>
    {!compact && registrationUrl && (
      <a
        class="button event-register-button"
        href={registrationUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Register
        <Arrow diagonal />
      </a>
    )}
    {!compact && countdownTo && (
      <section
        class="event-countdown"
        aria-label={`Countdown to ${event.title}`}
      >
        <p>Event starts in</p>
        <div class="countdown-values" data-countdown={countdownTo}>
          <span>
            <strong data-days>00</strong>
            <small>Days</small>
          </span>
          <span>
            <strong data-hours>00</strong>
            <small>Hours</small>
          </span>
          <span>
            <strong data-minutes>00</strong>
            <small>Minutes</small>
          </span>
          <span>
            <strong data-seconds>00</strong>
            <small>Seconds</small>
          </span>
        </div>
        <p class="countdown-complete" data-countdown-complete hidden>
          The event has started.
        </p>
      </section>
    )}
    {compact ? (
      <a class="text-link" href={href}>
        {site.labels.events}
        <Arrow />
      </a>
    ) : resourceLinks.length ? (
      <details class="event-resources">
        <summary class="button button-secondary">
          {site.labels.resources}
          <span class="resource-chevron" aria-hidden="true">
            ⌄
          </span>
        </summary>
        <div class="event-resource-menu">
          {resourceLinks.map((resource) => (
            <a href={resource.url} target="_blank" rel="noopener noreferrer">
              {resource.label}
              <Arrow diagonal />
            </a>
          ))}
        </div>
      </details>
    ) : (
      event.resourceUrl && (
        <a
          class="button button-secondary"
          href={event.resourceUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {site.labels.resources}
          <Arrow diagonal />
        </a>
      )
    )}
    <dl class="event-meta" aria-label="Event details">
      <div class="event-meta-item">
        <dt>{site.labels.date}</dt>
        <dd>
          {event.date ? (
            <time datetime={event.date}>{event.displayDate}</time>
          ) : (
            <span>{event.displayDate}</span>
          )}
        </dd>
      </div>
      {event.displayTime && (
        <div class="event-meta-item">
          <dt>{site.labels.time}</dt>
          <dd>{event.displayTime}</dd>
        </div>
      )}
      {event.location && (
        <div class="event-meta-item event-meta-venue">
          <dt>{site.labels.venue}</dt>
          <dd>{event.location}</dd>
        </div>
      )}
    </dl>
  </div>
</article>

<script>
  const padCountdownValue = (value: number) => String(value).padStart(2, "0");

  const updateCountdown = (countdown: HTMLElement) => {
    const target = countdown.dataset.countdown;
    if (!target) return false;

    const remaining = new Date(target).getTime() - Date.now();
    const complete = countdown.parentElement?.querySelector<HTMLElement>(
      "[data-countdown-complete]",
    );

    if (remaining <= 0) {
      countdown.hidden = true;
      if (complete) complete.hidden = false;
      return false;
    }

    const totalSeconds = Math.floor(remaining / 1000);
    const values = {
      days: Math.floor(totalSeconds / 86400),
      hours: Math.floor((totalSeconds % 86400) / 3600),
      minutes: Math.floor((totalSeconds % 3600) / 60),
      seconds: totalSeconds % 60,
    };

    for (const [unit, value] of Object.entries(values)) {
      const output = countdown.querySelector<HTMLElement>(`[data-${unit}]`);
      if (output) output.textContent = padCountdownValue(value);
    }
    return true;
  };

  const countdowns = Array.from(
    document.querySelectorAll<HTMLElement>("[data-countdown]"),
  );
  const tick = () => {
    let active = false;
    for (const countdown of countdowns) {
      active = updateCountdown(countdown) || active;
    }
    if (!active) window.clearInterval(interval);
  };
  const interval = window.setInterval(tick, 1000);
  tick();
</script>
