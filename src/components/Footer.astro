---
import site from "../data/site.json";
import { localUrl } from "../lib/urls";
import Arrow from "./Arrow.astro";
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={localUrl("/")}>
          <img src={localUrl(site.logo)} width="48" height="48" alt="" />
          <span>{site.name}</span>
        </a>
        <p>{site.footerDescription}</p>
        <a class="text-link" href={`mailto:${site.email}`}>
          {site.email}
          <Arrow diagonal />
        </a>
      </div>
      <nav aria-label="Footer navigation">
        <h2>{site.labels.explore}</h2>
        {site.navigation
          .filter((item) => item.label !== "Contact")
          .map((item) => (
            <a href={localUrl(item.href || item.children![0].href)}>
              {item.label}
            </a>
          ))}
      </nav>
      <nav aria-label="Social profiles">
        <h2>{site.labels.connect}</h2>
        {site.socials.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer">
            {social.label}
            <Arrow diagonal />
          </a>
        ))}
      </nav>
    </div>
    <div class="footer-bottom">
      <p>
        © {new Date().getFullYear()} {site.copyright}
      </p>
      <button
        id="motion-toggle"
        class="motion-toggle"
        hidden
        data-play={site.labels.playVideo}
        data-pause={site.labels.pauseVideo}
      >
        {site.labels.pauseVideo}
      </button>
    </div>
  </div>
</footer>
