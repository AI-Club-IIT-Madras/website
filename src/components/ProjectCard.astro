---
import type projects from "../data/projects.json";
import site from "../data/site.json";
import { localUrl } from "../lib/urls";
import Arrow from "./Arrow.astro";
interface Props {
  project: (typeof projects)[number];
}
const { project } = Astro.props;
const external = project.url?.startsWith("https:");
const currentTeamUrl =
  project.id === "viveka-2"
    ? "https://viveka.aiclubcfi.com/team.html#v2"
    : project.academicYear === "26-27"
      ? `/projects-26-27/${project.id}/#team`
      : null;
const externalTeam = currentTeamUrl?.startsWith("https:");
---

<article
  class:list={[
    "project-card card",
    { "archive-project-card": project.academicYear === "22-25" },
  ]}
>
  {project.image && (
    <img
      class:list={{ "project-image-contain": project.id === "kathai" }}
      src={localUrl(project.image)}
      width="600"
      height="320"
      alt={`${project.title} — project illustration`}
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="project-content">
    <h2>{project.title}</h2>
    {project.subtitle && <p class="project-subtitle">{project.subtitle}</p>}
    <p class="project-description">{project.description}</p>
    {project.tags.length > 0 && (
      <ul class="tags" aria-label="Topics">
        {project.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )}
    <div class="card-actions">
      {project.showProjectLink && project.url ? (
        <a
          class="button button-secondary"
          href={localUrl(project.url)}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
        >
          {site.labels.viewProject}
          <Arrow diagonal={external} />
        </a>
      ) : project.showProjectLink ? (
        <span class="todo-copy">{site.labels.missingProjectLink}</span>
      ) : null}
      {currentTeamUrl && (
        <a
          class="text-link"
          href={localUrl(currentTeamUrl)}
          target={externalTeam ? "_blank" : undefined}
          rel={externalTeam ? "noopener noreferrer" : undefined}
        >
          {site.labels.meetTeam}
          <Arrow diagonal={externalTeam} />
        </a>
      )}
    </div>
  </div>
</article>
