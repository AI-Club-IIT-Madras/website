---
import site from "../data/site.json";
import Arrow from "./Arrow.astro";
const { contact } = site;
---

<section class="section shell contact-section" id="contact">
  <div>
    <p class="eyebrow">{site.institution}</p>
    <h2 class="section-title">{site.contactHeading}</h2>
    <a class="contact-email text-link" href={`mailto:${site.email}`}>
      {site.email}
      <Arrow diagonal />
    </a>
    <p class="muted">{!contact.endpoint && contact.unconfigured}</p>
  </div>
  <div class="contact-panel">
    {contact.endpoint ? (
      <form method="POST" action={contact.endpoint}>
        <label>
          {contact.name}
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label>
          {contact.email}
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          {contact.message}
          <textarea name="message" rows="5" required />
        </label>
        <p class="muted">{contact.privacy}</p>
        <button class="button" type="submit">
          {contact.submit}
          <Arrow />
        </button>
      </form>
    ) : (
      <>
        <p class="eyebrow">{site.labels.connect}</p>
        <a class="button" href={`mailto:${site.email}`}>
          {contact.emailAction}
          <Arrow diagonal />
        </a>
        <p class="todo-copy">{contact.todo}</p>
      </>
    )}
  </div>
</section>
