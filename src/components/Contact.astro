---
import site from "../data/site.json";
import Arrow from "./Arrow.astro";
const { contact } = site;
interface Props {
  reveal?: "left" | "right" | "pop";
}
const { reveal } = Astro.props;
---

<section
  class="section shell contact-section"
  id="contact"
  data-reveal={reveal}
>
  <div>
    <p class="eyebrow">{site.institution}</p>
    <h2 class="section-title">{site.contactHeading}</h2>
    <a class="contact-email text-link" href={`mailto:${site.email}`}>
      {site.email}
      <Arrow diagonal />
    </a>
  </div>
  <div class="contact-panel">
    <form id="contact-form" action={contact.endpoint} method="post">
      <input type="hidden" name="_subject" value={contact.subject} />
      <input type="hidden" name="_honey" tabindex="-1" autocomplete="off" />
      <label>
        {contact.name}
        <input type="text" name="name" autocomplete="name" required />
      </label>
      <label>
        {contact.email}
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        {contact.message}
        <textarea name="message" rows="5" required></textarea>
      </label>
      <p class="muted">{contact.privacy}</p>
      <button class="button" type="submit">
        {contact.submit}
        <Arrow />
      </button>
      <p class="contact-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script define:vars={{ contact }}>
  const form = document.querySelector("#contact-form");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;

    const button = form.querySelector('button[type="submit"]');
    const status = form.querySelector(".contact-status");
    if (
      !(button instanceof HTMLButtonElement) ||
      !(status instanceof HTMLElement)
    )
      return;

    const fields = Object.fromEntries(new FormData(form));
    fields._replyto = fields.email;
    button.disabled = true;
    form.setAttribute("aria-busy", "true");
    status.textContent = contact.sending;

    try {
      const response = await fetch(contact.ajaxEndpoint, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(fields),
      });
      const result = await response.json();
      if (
        !response.ok ||
        result.success === false ||
        result.success === "false"
      ) {
        throw new Error("FormSubmit rejected the submission");
      }
      form.reset();
      status.textContent = contact.sent;
    } catch {
      status.textContent = contact.sendError;
    } finally {
      button.disabled = false;
      form.removeAttribute("aria-busy");
    }
  });
</script>
